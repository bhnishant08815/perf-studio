{
  "openapi": "3.0.3",
  "info": { "title": "Items API" },
  "servers": [{ "url": "https://api.example.com/v2" }],
  "security": [{ "bearer": [] }],
  "paths": {
    "/items/{id}": {
      "get": { "operationId": "getItem", "tags": ["Items"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }] }
    },
    "/items": {
      "get": {
        "summary": "List items",
        "tags": ["Items"],
        "parameters": [
          { "name": "limit", "in": "query", "required": true, "example": 10 },
          { "name": "sort", "in": "query" }
        ]
      },
      "post": { "tags": ["Items"], "requestBody": { "content": { "application/json": { "example": { "name": "pen" } } } } }
    },
    "/health": { "get": {} }
  }
}
